# /etc/beaconfix/beaconfix-hub.env — the hub's environment (deploy/beaconfix-hub.service, deploy/beaconfix-hub-cli).
# Plain KEY=value lines, no quotes, no spaces in values.

# Where everything lives (the unit's StateDirectory=/var/lib/beaconfix, mode 0700):
#   state/beaconfix/beaconfix.db      the encrypted master database (AES-256-GCM)
#   state/beaconfix/.live/live.db     its working (decrypted) copy while the hub runs — on the CT's (LUKS) disk
#   state/beaconfix/bfs3-counters     the replay windows (sealed)
#   state/beaconfix/hub-admin.json    admin listener url + token for the CLI (0600, new every start)
#   config/sworrl/beaconfix.key       the database key (0600) — back it up together with beaconfix.db
HOME=/var/lib/beaconfix
XDG_CONFIG_HOME=/var/lib/beaconfix/config
XDG_STATE_HOME=/var/lib/beaconfix/state
XDG_DATA_HOME=/var/lib/beaconfix/data
XDG_CACHE_HOME=/var/lib/beaconfix/cache
# (no XDG_RUNTIME_DIR on purpose: /run is a small tmpfs in the CT; the live copy goes under the state dir)

# BFS3 on the network: TLS directly, the full chain from fullchain.pem is sent
BEACONFIX_HUB_LISTEN=0.0.0.0:443
BEACONFIX_HUB_CERT=/etc/beaconfix/tls/fullchain.pem
BEACONFIX_HUB_KEY=/etc/beaconfix/tls/key.pem
# What invites tell devices to connect to
BEACONFIX_HUB_URL=https://hub.example.com
# Loopback admin listener (/api/v1 + hub/*, admin token only)
BEACONFIX_HUB_ADMIN=127.0.0.1:47823
# Optional: only accept connections from these sources (comma-separated CIDRs). Leave unset when the host
# masquerades the DNAT'ed traffic (every client then appears as the bridge gateway).
#BEACONFIX_HUB_ALLOW=10.0.0.0/24
# Optional: keep the database key elsewhere (e.g. a systemd credential: LoadCredential= + $CREDENTIALS_DIRECTORY)
#BEACONFIX_KEY_FILE=/var/lib/beaconfix/config/sworrl/beaconfix.key

# Qt: no PCRE JIT (the unit sets MemoryDenyWriteExecute=yes); no platform plugin is needed (QCoreApplication)
QT_ENABLE_REGEXP_JIT=0
