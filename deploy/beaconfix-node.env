# /etc/beaconfix/beaconfix-node.env — a headless node (deploy/beaconfix-node.service, docs/HUB.md)
HOME=/var/lib/beaconfix
XDG_CONFIG_HOME=/var/lib/beaconfix/config
XDG_STATE_HOME=/var/lib/beaconfix/state
XDG_DATA_HOME=/var/lib/beaconfix/data
XDG_CACHE_HOME=/var/lib/beaconfix/cache
QT_ENABLE_REGEXP_JIT=0
# The LAN API on port 47822 (paired devices; loopback trusted — e.g. to place a this-computer anchor): off by default
#BEACONFIX_NODE_API=1
# Advertise on the LAN (mDNS) — off by default
#BEACONFIX_NODE_MDNS=1
# A private hub certificate: an extra CA (the default hub has a public Let's Encrypt chain)
#BEACONFIX_HUB_CA=/etc/beaconfix/hub-ca.pem
