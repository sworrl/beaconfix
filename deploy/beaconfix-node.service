# BeaconFix headless node (docs/HUB.md): positions itself (Starlink, Wi-Fi via NetworkManager, BeaconDB …), syncs with
# the hub, publishes its live position, computes the hub's jobs. For the static RV VM or any machine without a session.
# Enrol once (node stopped):  runuser -u beaconfix -- env $(cat /etc/beaconfix/beaconfix-node.env | grep -v '^#' | xargs) beaconfix --node --enroll 'bfs3:…'
[Unit]
Description=BeaconFix headless node (sync + compute for the hub)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=beaconfix
Group=beaconfix
EnvironmentFile=/etc/beaconfix/beaconfix-node.env
ExecStart=/usr/local/bin/beaconfix --node
Restart=always
RestartSec=10
TimeoutStopSec=90
StateDirectory=beaconfix
StateDirectoryMode=0700
UMask=0077
ReadWritePaths=/var/lib/beaconfix
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# A refit batch uses the cores; keep the VM responsive
Nice=5
MemoryMax=1G

[Install]
WantedBy=multi-user.target
