# BeaconFix Wi-Fi RTT responder (IEEE 802.11mc Fine Timing Measurement).
# Generated by setup-rtt-responder.sh from data/beaconfix-rtt-responder.conf.in — edit the
# template or re-run the script, not this file.
#
# A hidden access point that exists only so other devices can time the flight of their FTM
# frames to it. Nobody joins it: the passphrase is random and the MAC access list is empty,
# and 802.11mc ranging works without association.

interface=@IFACE@
driver=nl80211
ctrl_interface=/run/beaconfix-hostapd
ctrl_interface_group=0

ssid=@SSID@
ignore_broadcast_ssid=1
country_code=@COUNTRY@
ieee80211d=1

hw_mode=@HWMODE@
channel=@CHANNEL@
beacon_int=@BEACON_INT@
dtim_period=2
wmm_enabled=1
ieee80211n=1
@BAND_EXTRA@

# The point of it all
ftm_responder=1
ftm_initiator=0

# No clients, ever
macaddr_acl=1
accept_mac_file=/etc/beaconfix/rtt-responder.accept
max_num_sta=1

auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK SAE
rsn_pairwise=CCMP
ieee80211w=1
sae_require_mfp=1
wpa_passphrase=@PSK@
