<?xml version="1.0" encoding="utf-8"?>
<!-- The BeaconFix LAN API is plain HTTP on private addresses unless the desktop has a certificate.
     Map tiles are HTTPS. Cleartext is permitted so a paired desktop on the LAN can be reached.
     The hub (docs/SECURE-API.md) is the exception: HTTPS only, with a publicly trusted certificate — no cleartext and
     no user-installed CAs for its domain. The client refuses http:// hub addresses for any domain as well. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">falcontechnix.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
