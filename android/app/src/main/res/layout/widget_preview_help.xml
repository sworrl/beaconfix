<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview of the Help widget (synthetic place names). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_preview_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🧸 Example Children’s Hospital" android:textColor="#E6EDF7" android:textStyle="bold" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call 911" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:background="#D93A3A" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Children’s ER" android:textColor="#35D6FF" android:textSize="11sp" android:maxLines="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="38 km · ~45 min (est.) · from you" android:textColor="#9FB0C8" android:textSize="11sp" android:maxLines="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="📞 Call    ➜ Go" android:textColor="#E6EDF7" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="ER: Example General Hospital · 12 km" android:textColor="#9FB0C8" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
