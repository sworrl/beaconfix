    "desktop": {"url": "", "token_file": "/etc/beaconfix-agent/token"},
    "gpsd": {"host": "127.0.0.1", "port": "2947"},
    "wifi": {"enabled": "yes", "interface": "auto"},
    "ble": {"enabled": "yes"},
    "anchor": {"enabled": "yes", "name": ""},
    "intervals": {"position": "10", "sync": "60", "fix": "60", "anchor": "600", "hello": "300", "ranging": "5", "wifi": "30", "links": "10"},
    "averaging": {"tau_prior": "90", "floor": "0.5", "floor_vertical": "1.0", "min_tau": "60", "longperiod_sigma": "1.0", "longperiod_tau": "1200"},
