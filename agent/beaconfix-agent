}


def load_config(path):
    cfg = configparser.ConfigParser()
    cfg.read_dict(DEFAULTS)
    if path and os.path.exists(path):
        cfg.read(path)
    if not cfg["anchor"].get("name"):
        cfg["anchor"]["name"] = "%s GPS antenna" % cfg["agent"].get("device", "pi")
    return cfg


def gnss_only(args, cfg):
    """Test mode: run gpsd + the averager only, write one JSON line per fix, exit at gpsd EOF."""
    host, port = cfg["gpsd"].get("host"), cfg["gpsd"].getint("port")
    g = cfg["averaging"]
    avg = StaticAverager(tau_prior_s=g.getfloat("tau_prior"), floor_h=g.getfloat("floor"), floor_v=g.getfloat("floor_vertical"), min_tau_s=g.getfloat("min_tau"),
                         lp_sigma=g.getfloat("longperiod_sigma"), lp_tau_s=g.getfloat("longperiod_tau"))
    stop = threading.Event()
    with open(args.report, "w") as rep:
        gps = Gpsd(host, port, avg, threading.Lock(), stop, report=rep, exit_on_eof=True)
        gps.start()
        gps.eof.wait()
        stop.set()
    print(json.dumps({"epochs": gps.epochs, "lastParked": avg.last_parked, "final": avg.result()}, indent=1))
    return 0


def main():
    ap = argparse.ArgumentParser(description="BeaconFix agent for a Raspberry Pi with a GNSS HAT (docs/AGENT.md)")
    ap.add_argument("--config", default="/etc/beaconfix-agent/agent.conf")
    ap.add_argument("--status", action="store_true", help="print the running agent's status and exit")
    ap.add_argument("--desktop", help="BeaconFix desktop URL, e.g. http://<desktop>:47822 (default: config, then mDNS)")
    ap.add_argument("--token-file")
    ap.add_argument("--gpsd", help="host:port of gpsd")
    ap.add_argument("--state-dir")
    ap.add_argument("--run-dir")
    ap.add_argument("--device")
    ap.add_argument("--no-wifi", action="store_true")
    ap.add_argument("--no-ble", action="store_true")
    ap.add_argument("--no-anchor", action="store_true")
    ap.add_argument("--fast", action="store_true", help="5x shorter intervals (tests)")
    ap.add_argument("--cycles", type=int, default=0, help="exit after N uplink cycles (tests)")
    ap.add_argument("--gnss-only", action="store_true", help="test mode: average what gpsd sends, write --report, exit at EOF")
    ap.add_argument("--report", default="gnss-report.jsonl")
    ap.add_argument("--verbose", "-v", action="store_true")
    ap.add_argument("--version", action="version", version="beaconfix-agent " + VERSION)
    args = ap.parse_args()
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO, format="%(levelname)s %(message)s", stream=sys.stderr)
    cfg = load_config(args.config)
    if args.desktop:
        cfg["desktop"]["url"] = args.desktop
    if args.token_file:
        cfg["desktop"]["token_file"] = args.token_file
    if args.gpsd:
        h, _, p = args.gpsd.rpartition(":")
        cfg["gpsd"]["host"], cfg["gpsd"]["port"] = h or "127.0.0.1", p
    if args.state_dir:
        cfg["agent"]["state_dir"] = args.state_dir
    if args.run_dir:
        cfg["agent"]["run_dir"] = args.run_dir
    if args.device:
        cfg["agent"]["device"] = args.device
    if args.status:
        p = os.path.join(cfg["agent"]["run_dir"], "status.json")
        s = read_text(p)
        print(s if s else json.dumps({"error": "no status at %s (is the service running?)" % p}))
        return 0 if s else 1
    if args.gnss_only:
        return gnss_only(args, cfg)
    agent = Agent(cfg, args)

    def on_signal(*_):
        agent.stop.set()
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    log.info("beaconfix-agent %s starting as %s (%s)", VERSION, agent.device, agent.kind)
    agent.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
